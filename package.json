{
  "name": "sports-results-app",
  "version": "1.0.0",
  "description": "Vibe Coding Challenge - Sports Results App",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:copy-public": "cp -R public dist || true",
    "preview": "vite preview",
    "test": "vitest",
    "test:ci": "vitest --run",
    "predeploy": "npm run build && npm run build:copy-public",
    "deploy": "gh-pages -d dist"
  },
  "keywords": [
    "sports",
    "nhl",
    "nfl",
    "real-time",
    "react",
    "vite"
  ],
  "author": "",
  "license": "ISC",
  "homepage": "https://UlrikeHeidler.github.io/sport-results",
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "jsdom": "^27.0.1",
    "vite": "^7.1.12",
    "vitest": "^1.0.0"
  }
}
