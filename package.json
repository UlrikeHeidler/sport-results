{
  "name": "sports-results-app",
  "version": "1.0.0",
  "description": "Vibe Coding Challenge - Sports Results App",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:copy-public": "cp -R public dist || true",
    "preview": "vite preview",
    "test": "vitest",
    "test:ci": "vitest --run",
    "predeploy": "npm run build && npm run build:copy-public",
    "deploy": "gh-pages -d dist"
  },
  "keywords": [
    "sports",
    "vibe-coding",
    "nfl",
    "nhl",
    "nba",
    "mlb",
    "scores",
    "mls",
    "soccer",
    "real-time",
    "react",
    "vite"
  ],
  "author": "",
  "license": "ISC",
  "homepage": "https://UlrikeHeidler.github.io/sport-results",
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.0.0",
    "dompurify": "^3.0.5",
    "eslint": "^8.45.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^27.0.1",
    "prettier": "^3.0.0",
    "terser": "^5.44.1",
    "typescript": "^5.0.2",
    "vite": "^7.1.12",
    "vitest": "^4.0.14"
  }
}
